# ══════════════════════════════════════════════════════════════
# Kivro Backend — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to git — it is in .gitignore.
# ══════════════════════════════════════════════════════════════

# ── Supabase ───────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ── Twilio SMS ─────────────────────────────────────────────────
# Get these from https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# ── Email (Resend — primary) ───────────────────────────────────
# Get from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=Kivro <hello@kivro.africa>

# ── Email (SMTP fallback — used if RESEND_API_KEY is absent) ──
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password

# ── Payments ───────────────────────────────────────────────────
# Flutterwave: https://dashboard.flutterwave.com/settings/apis
FLUTTERWAVE_SECRET_KEY=FLWSECK-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X

# Paystack: https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY=your_paystack_secret_key_here

# M-Pesa (Safaricom Daraja)
MPESA_CONSUMER_KEY=your_mpesa_consumer_key
MPESA_CONSUMER_SECRET=your_mpesa_consumer_secret
MPESA_SHORTCODE=your_mpesa_shortcode
MPESA_PASSKEY=your_mpesa_passkey
MPESA_CALLBACK_URL=https://your-backend.vercel.app/api/payments/mpesa/callback

# ── What3Words ─────────────────────────────────────────────────
# Get from https://developer.what3words.com/public-api
WHAT3WORDS_API_KEY=your_what3words_api_key

# ── Geocoding (optional — enhances accuracy) ──────────────────
MAPBOX_ACCESS_TOKEN=your_mapbox_access_token
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
LOCATIONIQ_API_KEY=your_locationiq_api_key

# ── Error monitoring ───────────────────────────────────────────
# Get from https://sentry.io → Settings → Projects → DSN
SENTRY_DSN=https://xxxx@oxxxx.ingest.sentry.io/xxxx

# ── Analytics ─────────────────────────────────────────────────
POSTHOG_API_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Server ─────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# ── Redis / Queue (BullMQ) ─────────────────────────────────────────────────────
# Upstash Redis: https://upstash.com (free tier available)
# OR self-hosted Redis URL
REDIS_URL=redis://localhost:6379
UPSTASH_REDIS_URL=rediss://default:xxxx@xxx.upstash.io:6379

# ── Africa's Talking (cheaper SMS in Africa) ───────────────────────────────────
# https://africastalking.com/sms
AT_USERNAME=your_africastalking_username
AT_API_KEY=your_africastalking_api_key
AT_SENDER_ID=KIVRO

# ── USSD (Africa's Talking USSD) ──────────────────────────────────────────────
# Register shortcode at https://africastalking.com/ussd
# Set callback URL to: https://your-backend.vercel.app/api/ussd/callback
USSD_SHORTCODE=*384*KIVRO#

# ── Billing ───────────────────────────────────────────────────────────────────
BILLING_WEBHOOK_SECRET=your_billing_webhook_secret
